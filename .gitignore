# Test Reports and Generated Files
/TestReports/

# Google Sheets Integration
credentials.json
token.pickle

# Validation Reports (optional - uncomment to track in git)
# *_validation_report.txt
# validation_report.txt

# Environment files with secrets
.env
.env.*
!.env.template

# BlenderKit raw source downloads (large .blend/.gltf originals, re-fetchable
# from Assets/BlenderKit/manifest.json — don't commit; the manifest + the
# exported FBX in Assets/FBX/generated/kitbash/ are what's tracked)
/Assets/BlenderKit/library/

# .fbm folders: side-effect texture extraction Blender creates when
# re-importing an embed_textures=True FBX (e.g. via fbx2obj.py) — pure
# derived duplicate of textures already embedded in the source .fbx itself,
# not something to commit.
*.fbm/

# Build package (for moving to another repo)
# Track extraction tooling but ignore extracted build files
build_package/*.bat
build_package/build_unix.sh
build_package/BUILD_*.md
build_package/UNREAL_BUILD_GUIDE.md
build_package/.github/
# Keep extraction script (force-added)
!build_package/extract_files.sh
# Ignore tar.gz archives
*.tar.gz

# Windows 'NUL' device artifact (created by output redirection like `cmd > NUL`)
NUL

# Don't ignore important Unreal files - these should be tracked!
# .uproject files
# .uplugin files
# .uasset and .umap files (Content assets)
# Config/ directory files

# Reference models (mixed CC licenses) — local inspection only, not shipped
ref_ships/

# Reference study textures (CC0) — local inspection only
ref_textures/

# self-learning queue
.claude/learnings-queue.jsonl
