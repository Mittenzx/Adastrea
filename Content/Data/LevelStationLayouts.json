{
  "_comment": "Level stations as Station Editor builds: each starts from its archetype's unique core and grows by attaching catalog modules to an existing module's face, exactly like clicking a face in the Station Editor (UStationEditorManager::FindAttachPosition). Tools/station_layouts.py turns these into Station Editor blueprint strings and validates them; Tools/build_level_stations.py places them in the level. Directions are world axes: N=+X, S=-X, E=+Y, W=-Y. 'rot' is yaw in degrees.",
  "GridSpacing": 400,
  "Cores": {
    "StationCore_TradeHub": 4,
    "StationCore_Agricultural": 4,
    "StationCore_Industrial": 3,
    "StationCore_Research": 3,
    "StationCore_Luxury": 3,
    "StationCore_BlackMarket": 3
  },
  "Stations": {
    "Station_TradeHub": {
      "core": "StationCore_TradeHub",
      "modules": [
        {"id": "CorN",    "item": "CorridorModule",    "on": "core",    "dir": "N"},
        {"id": "DockN",   "item": "DockingBayModule",  "on": "CorN",    "dir": "N"},
        {"id": "CorS",    "item": "CorridorModule",    "on": "core",    "dir": "S"},
        {"id": "DockS",   "item": "DockingBayModule",  "on": "CorS",    "dir": "S", "rot": 180},
        {"id": "MarketE", "item": "MarketplaceModule", "on": "core",    "dir": "E"},
        {"id": "MarketW", "item": "MarketplaceModule", "on": "core",    "dir": "W"},
        {"id": "CargoE",  "item": "CargoBayModule",    "on": "MarketE", "dir": "E"},
        {"id": "CargoW",  "item": "CargoBayModule",    "on": "MarketW", "dir": "W"},
        {"id": "Reactor", "item": "ReactorModule",     "on": "CargoE",  "dir": "S"},
        {"id": "Hab",     "item": "HabitationModule",  "on": "CargoW",  "dir": "S"},
        {"id": "Outfit", "item": "OutfittingModule", "on": "Reactor", "dir": "S"}
      ]
    },
    "Station_Agricultural": {
